{
    "name": "binuka200/eudi-wallet",
    "description": "Framework-neutral PHP façade for EU Digital Identity Wallet verification via a remote OpenID4VP verifier.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/binuka200/eudi-wallet-php",
    "keywords": [
        "eudi",
        "eidas",
        "openid4vp",
        "wallet",
        "pid",
        "verifiable-credentials"
    ],
    "authors": [
        {
            "name": "Binuka Jayaweera",
            "homepage": "https://github.com/binuka200"
        }
    ],
    "support": {
        "docs": "https://github.com/binuka200/eudi-wallet-php#readme",
        "issues": "https://github.com/binuka200/eudi-wallet-php/issues",
        "source": "https://github.com/binuka200/eudi-wallet-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EudiWallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EudiWallet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "cs": "tools/php-cs-fixer/vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs:install": "@composer install --working-dir=tools/php-cs-fixer --no-interaction",
        "live-check": "@php tools/live-check.php",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "lint": "Syntax-check every PHP file.",
        "analyse": "Run PHPStan at level 8.",
        "cs": "Report code-style violations (run cs:install once first).",
        "cs:fix": "Fix code-style violations in place.",
        "cs:install": "Install the isolated php-cs-fixer toolchain.",
        "live-check": "Exercise the client against a running verifier; see tools/live-check.php.",
        "check": "lint + analyse + test, what CI runs."
    }
}
